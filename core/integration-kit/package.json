{
  "name": "@core/integration-kit",
  "description": "Integration kit: the typed author API integrations are declared with (defineIntegration, port, defineConfig), the commerce contract suite (./testing) and the framework internals (./core).",
  "author": "creativestyle GmbH",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./core": {
      "shopin-framework": {
        "types": "./dist/types/core.d.ts",
        "default": "./dist/core.js"
      },
      "default": "./dist/core.js"
    }
  },
  "scripts": {
    "setup": "tsc",
    "build": "tsc",
    "check-types": "tsc --noEmit && tsc -p test",
    "lint": "eslint --max-warnings=0 --fix .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "tsc && node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "@core/contracts": "*"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@nestjs/testing": "^11.1.3"
  },
  "peerDependenciesMeta": {
    "@nestjs/testing": {
      "optional": true
    }
  }
}
