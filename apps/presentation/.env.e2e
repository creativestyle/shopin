# Env for build:e2e / start:e2e (test/e2e). No secrets: committed on purpose.
E2E_TEST=true
PORT=3100
# Platform specs: server-side calls go to the recording mock BFF
NEXT_BFF_INTERNAL_URL=http://localhost:3001
# Browser calls go through the journey stack's fault proxy (test/e2e/stack)
NEXT_PUBLIC_BFF_EXTERNAL_URL=http://localhost:4100/bff
FRONTEND_URL=http://localhost:3100
NEXT_DRAFT_MODE_SECRET=e2e-test-secret-do-not-use-in-prod
LOG_LEVEL=warn
