{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@config/constants#build",
        "@core/i18n#build",
        "@integrations/mock-commerce#build",
        "@integrations/commercetools-core#build",
        "@integrations/commercetools-commerce#build",
        "@integrations/commercetools-auth#build",
        "@integrations/contentful-cms#build",
        "@integrations/algolia-search#build"
      ]
    },
    "dev": {
      "with": [
        "@config/constants#dev",
        "@core/i18n#dev",
        "@integrations/mock-commerce#dev",
        "@integrations/commercetools-core#dev",
        "@integrations/commercetools-commerce#dev",
        "@integrations/commercetools-auth#dev",
        "@integrations/contentful-cms#dev",
        "@integrations/algolia-search#dev"
      ]
    }
  }
}
