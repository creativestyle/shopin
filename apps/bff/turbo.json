{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@config/constants#build",
        "@core/i18n#build",
        "@integrations/commerce-mock#build",
        "@integrations/commerce-commercetools#build",
        "@integrations/auth-commercetools#build",
        "@integrations/cms-contentful#build"
      ]
    },
    "dev": {
      "with": [
        "@config/constants#dev",
        "@core/i18n#dev",
        "@integrations/commerce-mock#dev",
        "@integrations/commerce-commercetools#dev",
        "@integrations/auth-commercetools#dev",
        "@integrations/cms-contentful#dev"
      ]
    }
  }
}
