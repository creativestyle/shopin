{
  "name": "shopin",
  "version": "0.1.0",
  "description": "Modular SHOPin storefront accelerator with BFF, Next.js presentation, and multi-data-source support",
  "author": "creativestyle GmbH",
  "license": "OSL-3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/creativestyle/shopin.git"
  },
  "bugs": {
    "url": "https://github.com/creativestyle/shopin/issues"
  },
  "homepage": "https://github.com/creativestyle/shopin#readme",
  "scripts": {
    "setup": "turbo run setup",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start:local": "turbo run start:local",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types",
    "check-dependencies": "npm audit --audit-level=critical",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "prepare": "husky install || true"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.5.0",
    "turbo": "^2.9.14",
    "typescript": "5.7.3",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@5": "^5.0.9",
    "fast-uri": "^3.1.5",
    "js-yaml@3": "^3.15.1",
    "js-yaml@4": "^4.3.1",
    "nanoid@3": "^3.3.18",
    "shell-quote": "^1.9.0",
    "svgo@3": "^3.3.4",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "uuid@9": "^11.1.1",
    "uuid@10": "^11.1.1"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "core/*",
    "integrations/*",
    "config/*",
    "demo/*",
    "test/*"
  ],
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "turbo run lint",
      "turbo run format"
    ],
    "*.{json,css,md}": [
      "turbo run format"
    ]
  }
}
