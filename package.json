{
  "name": "shopin",
  "version": "0.1.0",
  "description": "Modular SHOPin storefront accelerator with BFF, Next.js presentation, and multi-data-source support",
  "author": "creativestyle GmbH",
  "license": "OSL-3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/creativestyle/shopin.git"
  },
  "bugs": {
    "url": "https://github.com/creativestyle/shopin/issues"
  },
  "homepage": "https://github.com/creativestyle/shopin#readme",
  "scripts": {
    "config:check": "node scripts/setup.mjs --check",
    "setup": "node scripts/setup.mjs",
    "use": "node scripts/setup.mjs use",
    "build": "turbo run build --filter=./apps/*... --filter=./core/* --filter=./test/*... && node scripts/setup.mjs --check",
    "dev": "turbo run dev --filter=@apps/bff --filter=@apps/presentation",
    "dev:all": "turbo run dev --filter=./apps/*... --filter=./core/* --filter=./test/*...",
    "start:local": "turbo run start:local --filter=./apps/*... --filter=./core/* --filter=./test/*...",
    "lint": "turbo run lint --filter=./apps/*... --filter=./core/* --filter=./test/*... && npm run lint:boundaries",
    "lint:boundaries": "eslint --config eslint.boundaries.config.mjs --no-inline-config .",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types --filter=./apps/*... --filter=./core/* --filter=./test/*...",
    "check-dependencies": "npm audit --audit-level=critical",
    "test": "turbo run test --filter=./apps/*... --filter=./core/* --filter=./test/*... && node --test scripts/*.test.mjs",
    "e2e": "turbo run e2e",
    "e2e:demo": "npm run e2e:demo -w @test/e2e",
    "prepare": "husky install || true",
    "integrations:check": "node scripts/integrations-check.mjs",
    "migrate": "npm run migrate -w @integrations/contentful-migration"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "eslint": "^9.39.5",
    "husky": "^8.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.8.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.9.14",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "tmp": "0.2.7",
    "webpack-dev-middleware": "7.4.6"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "core/*",
    "config/*",
    "integrations/*/*",
    "demo/*",
    "test/*"
  ],
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "turbo run lint",
      "turbo run format"
    ],
    "*.{json,css,md}": [
      "turbo run format"
    ]
  }
}
