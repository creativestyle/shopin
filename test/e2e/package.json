{
  "name": "@test/e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cd ../.. && turbo run build --filter=@apps/bff --filter=@apps/presentation^... && npm run build:e2e -w @apps/presentation",
    "stack": "ts-node --project tsconfig.json stack/start-stack.ts",
    "e2e": "ts-node --project tsconfig.json scripts/e2e.ts",
    "e2e:headed": "ts-node --project tsconfig.json scripts/e2e.ts --headed",
    "e2e:ui": "ts-node --project tsconfig.json scripts/e2e.ts --ui",
    "report": "playwright show-report",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0"
  }
}
