{
  "name": "@integrations/commercetools-auth",
  "description": "NestJS module for Commercetools auth: login, register, logout, password reset, anonymous sessions, and email tokens",
  "author": "creativestyle GmbH",
  "private": true,
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "dev": "tsc --build tsconfig.build.json --watch",
    "lint": "eslint --fix ./src --max-warnings=0",
    "format": "prettier --write ./src",
    "format:check": "prettier --check --ignore-unknown ./src",
    "check-types": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@core/contracts": "*",
    "@integrations/commercetools-api": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*",
    "@types/jest": "30.0.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.3",
    "nestjs-pino": "^4.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
