{
  "name": "@integrations/mock-psp",
  "version": "0.0.0",
  "description": "Mock payment provider: sample payment methods and a demo payment link for the BFF, and the demo payment page the shopper lands on (./page, a storefront slot). No account needed; demo only.",
  "author": "creativestyle GmbH",
  "private": true,
  "exports": {
    ".": {
      "shopin-shop": {
        "types": "./dist/types/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "default": "./dist/server/index.js"
    },
    "./shopin": {
      "shopin-shop": {
        "types": "./dist/types/shopin.d.ts",
        "default": "./dist/shopin.js"
      },
      "default": "./dist/shopin.js"
    },
    "./page": {
      "shopin-shop": {
        "types": "./dist/page/types/index.d.ts",
        "default": "./dist/page/index.js"
      },
      "default": "./dist/page/index.js"
    },
    "./sources.css": "./sources.css"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json tsconfig.page.json",
    "dev": "tsc --build tsconfig.json tsconfig.page.json --watch",
    "lint": "eslint --fix ./src ./test --max-warnings=0",
    "format": "prettier --write ./src ./test",
    "format:check": "prettier --check --ignore-unknown ./src ./test",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.page.json",
    "setup": "tsc --build tsconfig.json tsconfig.page.json",
    "test": "tsc --build tsconfig.json tsconfig.page.json && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@core/contracts": "*",
    "@core/integration-kit": "*"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.14",
    "next": "16.4.6",
    "next-intl": "^4.9.2",
    "react": "19.2.4"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "next-intl": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
