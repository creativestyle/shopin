{
  "name": "@integrations/mock-commerce",
  "version": "0.0.0",
  "description": "Mock commerce: generated catalog, carts, wishlist, customers and orders for development and demos, no account needed.",
  "author": "creativestyle GmbH",
  "private": true,
  "exports": {
    ".": {
      "shopin-shop": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./shopin": {
      "shopin-shop": {
        "types": "./dist/types/shopin.d.ts",
        "default": "./dist/shopin.js"
      },
      "default": "./dist/shopin.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint --fix ./src ./test --max-warnings=0",
    "format": "prettier --write ./src ./test",
    "format:check": "prettier --check --ignore-unknown ./src ./test",
    "check-types": "tsc --noEmit",
    "setup": "tsc --build",
    "test": "tsc --build && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@config/constants": "*",
    "@core/contracts": "*",
    "@core/i18n": "*",
    "@core/integration-kit": "*"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*"
  },
  "peerDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "nestjs-pino": "^4.5.0"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    }
  }
}
