{
  "name": "@integrations/algolia-sync",
  "version": "0.0.0",
  "description": "Script that pushes commercetools products into an Algolia index (moved out of algolia-api so search has no commerce dependency)",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "sync": "npm run build && dotenv -e ../../../.env -- node dist/scripts/algolia-sync.js",
    "check-types": "tsc --noEmit",
    "setup": "tsc --build",
    "lint": "eslint --fix ./scripts ./test --max-warnings=0",
    "format": "prettier --write ./scripts ./test",
    "format:check": "prettier --check --ignore-unknown ./scripts ./test",
    "test": "tsc --build && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@config/constants": "*"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*"
  },
  "peerDependencies": {
    "@commercetools/platform-sdk": "^8.13.0",
    "algoliasearch": "^5.25.0",
    "commander": "14.0.3",
    "dotenv-cli": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@commercetools/platform-sdk": {
      "optional": true
    },
    "algoliasearch": {
      "optional": true
    },
    "commander": {
      "optional": true
    },
    "dotenv-cli": {
      "optional": true
    }
  },
  "shopin": {
    "toolOf": [
      "@integrations/algolia-search",
      "@integrations/commercetools-commerce"
    ],
    "env": [
      "ALGOLIA_WRITE_API_KEY"
    ]
  },
  "exports": {}
}
