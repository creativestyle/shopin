{
  "name": "@integrations/commercetools-auth",
  "version": "0.0.0",
  "description": "commercetools sign-in (auth category): identity against the customers of the commercetools project. Shares the client with the commerce part through @integrations/commercetools-core.",
  "author": "creativestyle GmbH",
  "private": true,
  "exports": {
    ".": {
      "shopin-shop": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./shopin": {
      "shopin-shop": {
        "types": "./dist/types/shopin.d.ts",
        "default": "./dist/shopin.js"
      },
      "default": "./dist/shopin.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint --fix ./src --max-warnings=0",
    "format": "prettier --write ./src",
    "format:check": "prettier --check --ignore-unknown ./src",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "setup": "tsc --build"
  },
  "dependencies": {
    "@core/contracts": "*",
    "@core/integration-kit": "*",
    "@integrations/commercetools-core": "*"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*",
    "@nestjs/testing": "^11.2.7"
  },
  "peerDependencies": {
    "@commercetools/platform-sdk": "^8.13.0",
    "@commercetools/ts-client": "^4.1.0",
    "@nestjs/common": "^11.1.3",
    "nestjs-pino": "^4.5.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@commercetools/platform-sdk": {
      "optional": true
    },
    "@commercetools/ts-client": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "jest": {
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "testEnvironment": "node"
  }
}
