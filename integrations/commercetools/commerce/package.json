{
  "name": "@integrations/commercetools-commerce",
  "version": "0.0.0",
  "description": "commercetools commerce (catalog, carts, customers, orders; its product search serves search through the BFF when no search integration is configured). Shares the client with the auth part through @integrations/commercetools-core.",
  "author": "creativestyle GmbH",
  "private": true,
  "exports": {
    ".": {
      "shopin-shop": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./shopin": {
      "shopin-shop": {
        "types": "./dist/types/shopin.d.ts",
        "default": "./dist/shopin.js"
      },
      "default": "./dist/shopin.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint --fix ./src --max-warnings=0",
    "format": "prettier --write ./src",
    "format:check": "prettier --check --ignore-unknown ./src",
    "check-types": "tsc --noEmit",
    "test": "tsc --build && node --test \"test/*.test.mjs\"",
    "setup": "tsc --build",
    "record:contract": "tsc --build && node --env-file=../../../.env test/record-contract.mjs"
  },
  "dependencies": {
    "@config/constants": "*",
    "@core/contracts": "*",
    "@core/i18n": "*",
    "@core/integration-kit": "*",
    "@integrations/commercetools-core": "*"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*",
    "@nestjs/testing": "^11.2.7"
  },
  "peerDependencies": {
    "@commercetools/platform-sdk": "^8.13.0",
    "@commercetools/ts-client": "^4.1.0",
    "@nestjs/common": "^11.1.3",
    "nestjs-pino": "^4.5.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@commercetools/platform-sdk": {
      "optional": true
    },
    "@commercetools/ts-client": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
