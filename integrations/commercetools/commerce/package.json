{
  "name": "@integrations/commercetools-commerce",
  "description": "NestJS module for Commercetools e-commerce API: catalog, cart, orders, customers, and service provider interface",
  "author": "creativestyle GmbH",
  "private": true,
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "dev": "tsc --build tsconfig.build.json --watch",
    "lint": "eslint --fix ./src --max-warnings=0",
    "format": "prettier --write ./src",
    "format:check": "prettier --check --ignore-unknown ./src",
    "check-types": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@commercetools/platform-sdk": "^8.13.0",
    "@config/constants": "*",
    "@core/contracts": "*",
    "@core/i18n": "*",
    "@integrations/commercetools-core": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.9"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "testEnvironment": "node"
  }
}
