{
  "name": "@integrations/commercetools-core",
  "version": "0.0.0",
  "description": "Code the commercetools parts share: the client, the token endpoint, the guest session, the variables and error helpers. No category and no port of its own.",
  "author": "creativestyle GmbH",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/types/env.d.ts",
      "default": "./dist/env.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint --fix ./src --max-warnings=0",
    "format": "prettier --write ./src",
    "format:check": "prettier --check --ignore-unknown ./src",
    "check-types": "tsc --noEmit",
    "test": "tsc --build && node --test \"test/*.test.mjs\"",
    "setup": "tsc --build"
  },
  "dependencies": {
    "@core/contracts": "*",
    "@core/integration-kit": "*"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*"
  },
  "peerDependencies": {
    "@commercetools/platform-sdk": "^8.13.0",
    "@commercetools/ts-client": "^4.1.0",
    "@nestjs/common": "^11.1.3"
  },
  "peerDependenciesMeta": {
    "@commercetools/platform-sdk": {
      "optional": true
    },
    "@commercetools/ts-client": {
      "optional": true
    }
  }
}
