{
  "name": "@integrations/contentful-migration",
  "version": "0.0.0",
  "description": "Tool of the Contentful cms part (setup time, not a runtime part): migration scripts for content types (Page, teasers, layout) and optional demo content seed",
  "author": "creativestyle GmbH",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc",
    "migrate": "npm run build && dotenv -e ../../../.env -- node dist/scripts/run-migrations.js",
    "lint": "eslint --fix ./scripts ./migrations ./test --max-warnings=0",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check-types": "tsc --noEmit",
    "setup": "rm -rf dist && tsc",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*",
    "eslint": "^9.20.1",
    "typescript": "5.7.3"
  },
  "peerDependencies": {
    "@contentful/rich-text-types": "^16.6.1",
    "commander": "14.0.3",
    "contentful-cli": "^4.0.2",
    "contentful-management": "^12.3.2",
    "contentful-migration": "^5.0.0",
    "dotenv-cli": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@contentful/rich-text-types": {
      "optional": true
    },
    "commander": {
      "optional": true
    },
    "contentful-cli": {
      "optional": true
    },
    "contentful-management": {
      "optional": true
    },
    "contentful-migration": {
      "optional": true
    },
    "dotenv-cli": {
      "optional": true
    }
  },
  "shopin": {
    "toolOf": [
      "@integrations/contentful-cms"
    ],
    "env": [
      "CONTENTFUL_MANAGEMENT_ACCESS_TOKEN"
    ]
  },
  "exports": {}
}
