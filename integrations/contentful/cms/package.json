{
  "name": "@integrations/contentful-cms",
  "version": "0.0.0",
  "description": "NestJS module for Contentful CMS: pages, layout (header/footer), and GraphQL delivery/preview API",
  "author": "creativestyle GmbH",
  "private": true,
  "exports": {
    ".": {
      "shopin-shop": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./shopin": {
      "shopin-shop": {
        "types": "./dist/types/shopin.d.ts",
        "default": "./dist/shopin.js"
      },
      "default": "./dist/shopin.js"
    },
    "./preview": {
      "shopin-shop": {
        "types": "./dist/types/preview.d.ts",
        "default": "./dist/preview.js"
      },
      "default": "./dist/preview.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint --fix ./src --max-warnings=0",
    "format": "prettier --write ./src",
    "format:check": "prettier --check --ignore-unknown ./src",
    "check-types": "tsc --noEmit",
    "test": "tsc --build && node --test \"test/*.test.mjs\"",
    "setup": "tsc --build"
  },
  "dependencies": {
    "@config/constants": "*",
    "@core/contracts": "*",
    "@core/integration-kit": "*"
  },
  "devDependencies": {
    "@core/eslint-config": "*",
    "@core/prettier-config": "*",
    "@core/typescript-config": "*",
    "@nestjs/testing": "^11.2.7"
  },
  "peerDependencies": {
    "@contentful/rich-text-types": "^16.6.1",
    "@nestjs/common": "^11.1.3",
    "graphql": "^16.12.0",
    "graphql-request": "^6.1.0",
    "nestjs-pino": "^4.5.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@contentful/rich-text-types": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "graphql-request": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
