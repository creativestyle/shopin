/**
 * Storefront slots: React components from UI-only packages or the shop's own files (next to this one), bundled
 * for the browser.
 * Export the slots the shop uses; one it leaves out (or sets to `undefined`) is hidden, so a SHOPin release that adds
 * a slot never breaks this file. The last line type-checks names and props.
 *
 * storefront-data.json and wired.mts next to this file are generated by `npm run setup` from
 * config/shop/shopin.config.ts (providers, image hosts; the slots the configured integrations fill, such as the
 * payment page); do not edit them. A slot exported here wins over the integration's.
 */
import type { StorefrontSlots } from "@core/integration-kit";

/** The payment page: the payment integration in shopin.config.ts fills it (wired.mts); set it to use your own. */
export const PaymentStep = undefined;
/** The shop's own cart fields, under the cart summary (`({ cart, setFields }) => …`). */
export const CartExtra = undefined;
/** The shop's own pages, by path: `{ "setup": SetupPage }` serves /setup. */
export const Pages = undefined;
({
  PaymentStep,
  CartExtra,
  Pages,
}) satisfies StorefrontSlots;
