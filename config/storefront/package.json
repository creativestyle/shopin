{
  "name": "@shopin/storefront",
  "version": "0.0.0",
  "description": "The shop's storefront side: storefront.mts (UI slots from UI packages or the shop's own files) and storefront-data.json (generated by `npm run setup` from config/shop). Dependencies are written by `npm run setup`.",
  "private": true,
  "main": "./dist/storefront.mjs",
  "types": "./dist/storefront.d.mts",
  "scripts": {
    "setup": "tsc",
    "build": "tsc",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@integrations/mock-cms": "*",
    "@integrations/mock-psp": "*",
    "next": "16.4.6",
    "next-intl": "^4.9.2",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@core/i18n": "*",
    "@core/integration-kit": "*",
    "@core/typescript-config": "*",
    "typescript": "^5.7.3"
  },
  "exports": {
    ".": {
      "types": "./dist/storefront.d.mts",
      "default": "./dist/storefront.mjs"
    },
    "./wired": {
      "types": "./dist/wired.d.mts",
      "default": "./dist/wired.mjs"
    },
    "./storefront-data.json": "./storefront-data.json",
    "./theme.css": "./theme.css",
    "./sources.css": "./sources.css"
  }
}
