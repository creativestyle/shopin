# =============================================================================
# SHOPin storefront accelerator – environment template
# =============================================================================
# `npm run setup` copies this file to .env (with random local keys) and adds the configured integrations'
# variables. Do not commit .env or real secrets.
# One file for the repository. The BFF keeps its own variables (FRONTEND_URL, JWT_*, CSRF_*, BFF_*, LOG_*, …);
# every integration variable reaches only the port that declares it. The storefront (next.config.ts) takes
# only NEXT_*, FRONTEND_URL and LOG_* from this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Storefront and BFF URLs (local defaults)
# -----------------------------------------------------------------------------
# The storefront's origin (CORS origin for the BFF). The storefront reads it too: https selects the cookie-based
# preview token for /api/draft (anything else puts the token in the ?__pt= URL param).
FRONTEND_URL=http://localhost:3000
# BFF base URL including /bff: server-side (internal) and in the browser (public, embedded at build time).
NEXT_BFF_INTERNAL_URL=http://localhost:4000/bff
NEXT_PUBLIC_BFF_EXTERNAL_URL=http://localhost:4000/bff

# -----------------------------------------------------------------------------
# Logging (optional)
# -----------------------------------------------------------------------------
# Log level: trace | debug | info | warn | error | fatal. Used by BFF and presentation.
LOG_LEVEL=info

# When true, logs are pretty-printed for development. Use false in production.
LOG_PRETTY_PRINT=true

# -----------------------------------------------------------------------------
# BFF rate limiting (optional)
# -----------------------------------------------------------------------------
# Set to true to enable. When enabled, BFF_RATE_LIMIT_TTL and BFF_RATE_LIMIT_LIMIT are required.
BFF_RATE_LIMIT_ENABLED=true

# Global limit: time window in milliseconds and max requests per IP per window.
# Recommended: 100–200 for normal traffic.
BFF_RATE_LIMIT_TTL=60000
BFF_RATE_LIMIT_LIMIT=100

# Stricter limit for sensitive routes (auth, payment, order creation, password change).
BFF_RATE_LIMIT_SECURE_TTL=60000
BFF_RATE_LIMIT_SECURE_LIMIT=5

# Shared secret between presentation and BFF for server-side calls on behalf of a shopper
# (the checkout guard). Must be the same value in both apps. When set, the BFF skips rate
# limiting for those calls; when empty, they all share the Next.js server's rate-limit bucket.
# Secret; use a long random value and never expose it to the browser.
BFF_INTERNAL_SECRET=
# Behind a load balancer, CDN or reverse proxy: how many proxies stand in front of the BFF (e.g. 1), or their
# addresses/subnets (e.g. loopback, 10.0.0.0/8). The limits then count each shopper's address, not the proxy's.
# Off when unset. Set it only for proxies you run: a client could otherwise choose its own address.
# BFF_TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Draft mode
# -----------------------------------------------------------------------------
# Secret for Next.js Draft Mode (/api/draft?secret=...). Set a strong random value.
# Secret; provide via CI/CD or secure config in production.
NEXT_DRAFT_MODE_SECRET=

# -----------------------------------------------------------------------------
# BFF security – token encryption and signing (required for auth and CSRF)
# -----------------------------------------------------------------------------
# Four base64-encoded 32-byte keys. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ENCRYPTION_KEY=
JWT_SIGNING_KEY=
CSRF_TOKEN_ENCRYPTION_KEY=
CSRF_TOKEN_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Integration variables
# -----------------------------------------------------------------------------
# None here: `npm run setup` appends the variables the configured integrations need (empty, under a comment naming
# the integration and its README, which says what each one is) and comments out the block of an integration the
# config no longer names.
